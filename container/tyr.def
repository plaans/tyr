Bootstrap: docker
From: python:3.12-bullseye

%files
    .git/* .git/
    .gitmodules
    requirements/* requirements/
    src/* src/
    # tests/* tests/
    Justfile
    pyproject.toml

%post
    # Remove example configuration files
    ls -d src/tyr/configuration/* | grep yaml | grep example | xargs -r rm

    # Install Apptainer (Apptainer-ception !)
    apt update && apt install -y wget
    wget https://github.com/apptainer/apptainer/releases/download/v1.3.0/apptainer_1.3.0_amd64.deb
    apt install -y ./apptainer_1.3.0_amd64.deb

    # Install Java
    apt install -y default-jre

    # Install Rust
    apt install -y build-essential curl
    curl https://sh.rustup.rs | sh -s -- --no-modify-path -y
    . "$HOME/.cargo/env"
    
    # Install dependencies for NextFLAP
    # Install newer Z3 version from source to fix API compatibility with NextFLAP
    apt install -y cmake pkg-config python3-distutils
    cd /tmp
    wget https://github.com/Z3Prover/z3/archive/z3-4.12.2.tar.gz
    tar -xzf z3-4.12.2.tar.gz
    cd z3-z3-4.12.2
    python3 scripts/mk_make.py
    cd build
    make -j$(nproc)
    make install
    ldconfig
    # Create pkg-config file for Z3
    mkdir -p /usr/local/lib/pkgconfig
    cat > /usr/local/lib/pkgconfig/z3.pc << 'EOF'
prefix=/usr/local
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: z3
Description: The Z3 Theorem Prover
Version: 4.12.2
Libs: -L${libdir} -lz3
Cflags: -I${includedir}
EOF
    # Update PKG_CONFIG_PATH to include the new pkg-config directory
    export PKG_CONFIG_PATH="/usr/local/lib/pkgconfig:$PKG_CONFIG_PATH"
    cd /
    rm -rf /tmp/z3*

    # Install Just
    cargo install just

    # Install Tyr
    apt install -y git
    # just --set PY_D . --set PY_T dev install-full
    just --set PY_D . --set PY_T dev install-pip install-custom-domains install-nextflap install-aries
    VERSION="$(just --set PY_D . tyr --version)"
    echo "VERSION: $VERSION" >> "$APPTAINER_LABELS"

%runscript
    exec python -m tyr "$@"

# %test
#     python -m pytest tests/

%labels
    Author: Roland Godet <rgodet@laas.fr>
    Name: tyr
